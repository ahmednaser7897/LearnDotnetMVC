@*
    =================================
              MVC Layouts
    =================================

    Layout:
    A shared page used by multiple Views.

    ---------------------------------
    1. General Layout
    ---------------------------------

    The default layout used by most Views.

    File:
        Views/Shared/_Layout.cshtml

    Set in:
        Views/_ViewStart.cshtml

    Example:

        @{
            Layout = "_Layout";
        }

    ---------------------------------
    2. Custom Layout
    ---------------------------------

    A special layout created for a specific
    part of the application.

    Example:

        _AdminLayout.cshtml

    Used by an Admin View:

        @{
            Layout = "_AdminLayout";
        }

    ---------------------------------
    Difference
    ---------------------------------

    General Layout
        → Common for most/all Views.

    Custom Layout
        → Special layout for specific Views.

    ---------------------------------
    @RenderBody()
    ---------------------------------

    Displays the content of the current View.

    Example:

        Navbar
        @RenderBody()
        Footer
*@
<!DOCTYPE html>

<html>

<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
</head>

<body>

    <div style="height:150px;background-color:burlywood;font-size:30px">
        Header

        <div style="background-color:darkcyan;">
            @RenderSection("HeadSection")
        </div>
    </div>


    <div style="height:300px;background-color:darkcyan;">
        @RenderBody()
    </div>


    <div style="height:50px;background-color:burlywood;font-size:40px">
        Footer

        <div style="background-color:darkcyan;">
            @RenderSection("FooterSection")
        </div>
    </div>

</body>

</html>