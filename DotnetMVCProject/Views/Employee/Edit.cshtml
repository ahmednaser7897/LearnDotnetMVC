@model EmpWithDeptViewModelcs
@{
    ViewData["Title"] = "Edit Employee";
}

<h1>@ViewData["Title"]</h1>

<form action="/Employee/SaveEdit/@Model.Employee.Id" method="post">
    <label for="Name">Name</label>
    <input type="text" id="Name" name="Name" value="@Model.Employee.Name">
    <br>
    <label for="Salary">Salary</label>
    <input type="text" id="Salary" name="Salary" value="@Model.Employee.Salary">
    <br>
    <label for="JopTitle">JopTitle</label>
    <input type="text" id="JopTitle" name="JopTitle" value="@Model.Employee.JopTitle">
    <br>
    <label for="ImageUrl">ImageUrl</label>
    <input type="text" id="ImageUrl" name="ImageUrl" value="@Model.Employee.ImageUrl">
    <br>
    <label for="Address">Address</label>
    <input type="text" id="Address" name="Address" value="@Model.Employee.Address">
    <br>
    <label for="DepartmentId">Department</label>
    <select name="DepartmentId" id="DepartmentId">
        @foreach (var dept in Model.Departments)
        {
            @if (dept.Id == Model.Employee.DepartmentId)
            {
                <option value="@dept.Id" selected>@dept.Name</option>
            }
            else
            {
                <option value="@dept.Id">@dept.Name</option>
            }
        }
    </select>
    <button type="submit">Edit Employee</button>
</form>

<div class="mt-3">
    <a href="/Employee/Index" class="btn btn-secondary">Back to
        Employees
        List</a>
    </div>


