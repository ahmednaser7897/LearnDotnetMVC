@model Employee

@{
    ViewData["Title"] = "Employee ViewData Details";
}
<h1>@ViewData["Title"]</h1>

<h2>Data from ViewData</h2>
@if (ViewData["msg"] != null)
{
    <p>@ViewData["msg"]</p>
}

@if (ViewData["temp"] != null)
{
    <p>Temperature: @ViewData["temp"]</p>
    <p>Temperature - 10: @(Convert.ToInt32(ViewData["temp"]) - 10)</p>
}
@if (ViewData["branches"] != null)
{
    <!--this will print the type -->
    <p>branches: @ViewData["branches"]</p>
    <!--so becouse branches is a list so we need to loop over it to print each element -->
    <!--we use as to cast it to list-->
    <ul>
        @foreach (var branch in (ViewData["branches"] as List<string> ?? []))
        {
            <li>@branch</li>
        }
    </ul>
}


<!--we use data from model object it self-->
<h2>Data from ViewData.Model</h2>
@if (ViewData.Model != null)
{
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@ViewData.Model.Id</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@ViewData.Model.Name</dd>

        <dt class="col-sm-2">Salary</dt>
        <dd class="col-sm-10">@ViewData.Model.Salary</dd>
    </dl>
}
else
{
    <p>No employee data available.</p>
}


<h2>Data from Model</h2>
<!--we use data from model object it self-->
@if (Model != null)
{
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Salary</dt>
        <dd class="col-sm-10">@Model.Salary</dd>
    </dl>
}
else
{
    <p>No employee data available.</p>
}

