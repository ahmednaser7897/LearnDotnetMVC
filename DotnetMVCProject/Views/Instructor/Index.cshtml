*@
<style>
    table {
        width: 100%;
        border-collapse: collapse;
    }

    th,
    td {
        padding: 10px;
        border: 1px solid #ddd;
        text-align: left;
    }

    th {
        background: #f5f5f5;
    }

    img {
        width: 40px;
        height: 40px;
        border-radius: 50%;
    }
</style>

@Html.Label("Instructors", "Instructors", new { @class = "form-control", @style = "color:red" })
@* <h1>Instructors</h1> *@

@if (Model != null)
{
    <table>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Salary</th>
            <th>Address</th>
            <th>Image</th>
            <th>Department</th>
            <th>Course</th>
        </tr>

        @foreach (var instructor in Model)
        {
            <tr>
                <td>@instructor.Id</td>
                <td>@instructor.Name</td>
                <td>@instructor.Salary</td>
                <td>@instructor.Address</td>
                <td>
                    <img src="@instructor.ImageUrl" />
                </td>
                <td>@instructor.Department?.Name</td>
                <td>@instructor.Course?.Name</td>
            </tr>
        }
    </table>
}
else
{
    <p>No instructors available.</p>
}
@Html.ActionLink("Home", "Index", "Home", new { }, new { @class = "btn btn-primary" })

