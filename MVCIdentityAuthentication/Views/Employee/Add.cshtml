@model EmpWithDeptViewModelcs
@{
    ViewData["Title"] = "Add Employee";
    var deptSelectList = new SelectList(Model.Departments, "Id", "Name");
}

<h1>@ViewData["Title"]</h1>

<form asp-action="SaveAdd" asp-controller="Employee" method="post">
    <div asp-validation-summary="All" class="text-danger">
    </div>

    <label for="Name">Name</label>
    <input asp-for="Employee.Name">
    <span asp-validation-for="Employee.Name" class="text-danger"></span>
    <br>
    <label asp-for="Employee.Salary">Salary</label>
    <input asp-for="Employee.Salary">
    <span asp-validation-for="Employee.Salary" class="text-danger"></span>
    <br>
    <label asp-for="Employee.JopTitle">JopTitle</label>
    <input asp-for="Employee.JopTitle">
    <span asp-validation-for="Employee.JopTitle" class="text-danger"></span>
    <br>
    <label asp-for="Employee.ImageUrl">ImageUrl</label>
    <input asp-for="Employee.ImageUrl">
    <span asp-validation-for="Employee.ImageUrl" class="text-danger"></span>
    <br>
    <label asp-for="Employee.Address">Address</label>
    <input asp-for="Employee.Address">
    <span asp-validation-for="Employee.Address" class="text-danger"></span>
    <br>
    <label asp-for="Employee.DepartmentId">Department</label>
    <select asp-for="Employee.DepartmentId" asp-items="deptSelectList">
        <option value="">-- Choose Department --</option>
    </select>
    <span asp-validation-for="Employee.DepartmentId" class="text-danger"></span>
    <button type="submit">Add Employee</button>
</form>
<!--To make client side validation working we need to include the following scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script>
    console.log("jQuery:", typeof jQuery);
    console.log("validate:", typeof $.fn.validate);
</script>
<div class="mt-3">
    <a asp-action="Index" asp-controller="Employee" class="btn btn-secondary">Back to
        Employees
        List</a>
    </div>
    
